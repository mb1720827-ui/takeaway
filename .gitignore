# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# worker output
worker.log*

# worker state (daily reminder)
.worker-state.json

# Impeccable runtime files (screenshots, decision mocks); PRODUCT.md, DESIGN.md, .impeccable/surfaces and design.json are committed.
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
.impeccable/hook.cache.json

# Browser cookie exports are logins; never commit one.
*cookies*.txt

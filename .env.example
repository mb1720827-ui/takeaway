# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Dashboard > Project Settings > API (publishable/anon key only; never the secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Worker only (your laptop). Not needed on Vercel. ---
# The account the worker signs in as: the same one you use in the app.
TAKEAWAY_EMAIL=you@example.com
TAKEAWAY_PASSWORD=your-password
# Your deployed app, so notifications open the right note.
TAKEAWAY_APP_URL=https://your-app.vercel.app
# Optional: a long random ntfy topic for phone notifications (anyone who knows it can read them).
NTFY_TOPIC=
# Optional: path to a cookies.txt export of your Instagram login, for reels only logged-in users can see.
# Keep the file outside this folder and never commit it. Only Instagram links use it.
INSTAGRAM_COOKIES=
# Optional: model for Claude Code (e.g. sonnet) and how often to check for new saves and questions.
TAKEAWAY_MODEL=
TAKEAWAY_POLL_SECONDS=15
# Optional: path to Claude Code if it isn't found automatically.
CLAUDE_BIN=
# Optional: hour (0-23, local time) for the daily "cards to recall" notification.
TAKEAWAY_RECALL_HOUR=8

# Optional: your Stride app, so "Try this" ideas get a "Plan it in Stride" link.
STRIDE_URL=

# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Dashboard > Project Settings > API (publishable/anon key only; never the secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Worker only (your laptop). Not needed on Vercel. ---
# The account the worker signs in as: the same one you use in the app.
TAKEAWAY_EMAIL=you@example.com
TAKEAWAY_PASSWORD=your-password
# Your deployed app, so notifications open the right note.
TAKEAWAY_APP_URL=https://your-app.vercel.app
# Optional: a long random ntfy topic for phone notifications (anyone who knows it can read them).
NTFY_TOPIC=
# Optional: model for Claude Code (e.g. sonnet) and how often to check for new saves.
TAKEAWAY_MODEL=
TAKEAWAY_POLL_SECONDS=60
# Optional: path to Claude Code if it isn't found automatically.
CLAUDE_BIN=
